{
  "name": "blinkit-monorepo",
  "private": true,
  "scripts": {
    "dev:all": "concurrently \"cd backend && npm run dev\" \"cd frontend && npm run dev\" \"cd admin && npm run dev\"",
    "dev-backend": "cd backend && npm run dev",
    "dev-frontend": "cd frontend && npm run dev",
    "dev-admin": "cd admin && npm run dev"
  },
  "devDependencies": {
    "concurrently": "7.6.0"
  }
}
